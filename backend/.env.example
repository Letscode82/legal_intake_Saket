# AEGIS backend environment.
# In production, missing required vars crash startup (see app/core/config.py).

# ── Environment ──────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production

# ── Database (async SQLAlchemy URL) ──────────────────────────────────
# Local dev: the docker-compose Postgres. Production: Neon.
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:5432/aegis

# ── AI (Anthropic) — the ONLY place the key is used ──────────────────
# Unset → agents degrade to human-review-only recommendations.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Auth0 (the frontend logs in; the backend validates the JWT) ──────
# Unset in dev → every request resolves to the seeded admin (DEV_USER_EMAIL).
# Required in production.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
DEV_USER_EMAIL=alex.nguyen@aegis-demo.example

# ── CORS — only the frontend origin(s) may call the backend ──────────
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# ── At-rest encryption key (required in production) ──────────────────
ENCRYPTION_KEY=

# ── Seed (production must set real values) ───────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
